  "dialogues": [
    {
      "order": 1,
      "text": "आम खाने का निंजा तरीका, छिलके पर कट्स लगाएं और परफेक्ट स्लाइस तुरंत बाहर आ जाएंगे।"
    },
    {
      "order": 2,
      "text": "दस्ट पैन पर कंगा लगा दो, जाडू के सारे बाल एक जटके में निकल जाएंगे।"
    },
    {
      "order": 3,
      "text": "संत्रा छीलने का सबसे तेज तरीका अंगूठों से बीच में दबाएं और संत्रा तुरंत खुल जाएं"
    },
    {
      "order": 4,
      "text": "जूसर नहीं है, किचन के चिम्टे से नीमू दबाएं और पल भर में सारा रस बाहर."
    },
    {
